027F 01 00 40     	    ld bc,&4000
0282 DD 21 59 00  	    ld ix,&0059
0286 CD 42 02     	    call bios_call
0289 3E 01        	    ld a,1
028B 32 04 05     	    ld (video_saved),a
028E 06 20        	    ld b,&20
0290 0E 01        	    ld c,1
0292 DD 21 47 00  	    ld ix,&0047
0296 CD 42 02     	    call bios_call
0299 3E 07        	    ld a,7
029B 32 AF FC     	    ld (SCRMOD),a
                 	    ; Select Graphic 6, display page 0; preserve palette and PAL/NTSC.
029E 06 0A        	    ld b,&0A
02A0 0E 00        	    ld c,0
02A2 CD FE 02     	    call screen_reg
02A5 06 1F        	    ld b,&1F
02A7 0E 02        	    ld c,2
02A9 CD FE 02     	    call screen_reg
02AC 06 01        	    ld b,1
02AE 0E 07        	    ld c,7
02B0 CD FE 02     	    call screen_reg
02B3 06 0A        	    ld b,&0A
02B5 0E 08        	    ld c,8
02B7 CD FE 02     	    call screen_reg
02BA 3A F2 04     	    ld a,(saved_regs+9)
02BD E6 02        	    and &02
02BF F6 80        	    or &80
02C1 47           	    ld b,a
02C2 0E 09        	    ld c,9
02C4 CD FE 02     	    call screen_reg
02C7 06 00        	    ld b,0
02C9 0E 0E        	    ld c,14
02CB CD FE 02     	    call screen_reg
02CE 06 00        	    ld b,0
02D0 0E 17        	    ld c,23
02D2 CD FE 02     	    call screen_reg
                 	    ; Clear bottom 20 scanlines. ROWBUF remains a single scanline.
02D5 21 00 50     	    ld hl,ROWBUF
02D8 01 00 01     	    ld bc,256
02DB 3E 11        	    ld a,&11
02DD CD 97 03     	    call fill_memory
02E0 3E C0        	    ld a,192
02E2 32 09 05     	    ld (render_y),a
