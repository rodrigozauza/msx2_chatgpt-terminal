02F6 3A 9B 06     	    ld a,(render_y)
02F9 3C           	    inc a
02FA 32 9B 06     	    ld (render_y),a
02FD FE D4        	    cp 212
02FF C2 F3 02     	    jp nz,screen_bottom
0302 CD A6 03     	    call mark_all
0305 CD E5 03     	    call render_dirty
0308 06 60        	    ld b,&60
030A 0E 01        	    ld c,1
                 	screen_reg:
030C DD 21 47 00  	    ld ix,&0047
0310 C3 42 02     	    jp bios_call
                 	screen_leave:
0313 3A 96 06     	    ld a,(video_saved)
0316 B7           	    or a
0317 C8           	    ret z
0318 06 20        	    ld b,&20
031A 0E 01        	    ld c,1
