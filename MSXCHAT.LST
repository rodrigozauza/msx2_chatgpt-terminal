0395 E5           	    push hl
0396 D5           	    push de
0397 5F           	    ld e,a
0398 16 00        	    ld d,0
039A 21 00 58     	    ld hl,DIRTY
039D 19           	    add hl,de
039E 7E           	    ld a,(hl)
039F F6 01        	    or 1
03A1 77           	    ld (hl),a
03A2 D1           	    pop de
03A3 E1           	    pop hl
03A4 F1           	    pop af
03A5 C9           	    ret
                 	mark_all:
03A6 21 00 58     	    ld hl,DIRTY
03A9 01 18 00     	    ld bc,TEXT_ROWS
03AC 3E 03        	    ld a,3
03AE C3 B1 03     	    jp fill_memory
                 	
                 	; Fill BC bytes at HL with A, including safe zero/one-byte handling.
                 	fill_memory:
03B1 32 AC 06     	    ld (fill_value),a
03B4 78           	    ld a,b
03B5 B1           	    or c
03B6 C8           	    ret z
03B7 3A AC 06     	    ld a,(fill_value)
03BA 77           	    ld (hl),a
03BB 0B           	    dec bc
03BC 78           	    ld a,b
03BD B1           	    or c
03BE C8           	    ret z
03BF 54           	    ld d,h
03C0 5D           	    ld e,l
03C1 13           	    inc de
03C2 ED B0        	    ldir
03C4 C9           	    ret
                 	
                 	; A=row -> HL=GRID+row*80; destroys DE.
                 	grid_row_address:
