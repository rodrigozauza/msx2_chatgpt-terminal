0100              	    org &0100
0100 C3 03 01     	    jp main
                 	
                 	; MSX2 MAIN-ROM BIOS and fixed TPA allocation. No DOS2/Nextor-only calls.
0103              	BDOS: equ &0005
0103              	CALSLT: equ &001C
0103              	EXPTBL: equ &FCC1
0103              	RG0SAV: equ &F3DF
0103              	SCRMOD: equ &FCAF
0103              	CNSDFG: equ &F3DE
0103              	JIFFY: equ &FC9E
0103              	GRID: equ &4400
0103              	EDITOR: equ &4C00
0103              	ROWBUF: equ &5400
0103              	NAMES: equ &5500
0103              	DIRTY: equ &5800
0103              	ROWCOLORS: equ &5820
0103              	OVERLAY_BACKUP: equ &5900
0103              	OVERLAY_COLORS: equ &5F00
0103              	INPUT_OLD: equ &5F40
0103              	VRAM_BACKUP: equ &6400
0103              	MSG_BUFFER: equ &A000
0103              	REPLY_BUFFER: equ &A800
0103              	IOBUF: equ &B000
0103              	META: equ &B100
0103              	P_PROTOCOL: equ META
0103              	P_REQUEST: equ META+16
0103              	P_CONVERSATION: equ META+25
0103              	P_STATE: equ META+34
0103              	P_RESPONSE: equ META+50
0103              	P_ERROR: equ META+59
0103              	KEY_BUFFER: equ META+96
0103              	FIELD_LENGTHS: equ META+128
0103              	FCB: equ &B200
0103              	HEX_BUFFER: equ &B300
0103              	HISTORY_TEXT: equ &B400
0103              	RAM_END: equ &C000
0103              	EDITOR_MAX: equ 2047
0103              	COLUMNS: equ 80
0103              	TEXT_ROWS: equ 24
0103              	CELL_HEIGHT: equ 8
0103              	GRID_STRIDE: equ 80
0103              	STATUS_ROW: equ 19
0103              	FOOTER_ROW: equ 23
0103              	INPUT_ROWS: equ 3
0103              	HISTORY_VIEW_ROWS: equ 17
0103              	OVERLAY_ROWS: equ 18
0103              	INPUT_ROW: equ 20
0103              	INPUT_BASE: equ GRID+INPUT_ROW*GRID_STRIDE
                 	
                 	; Network buffers share the history cache only while history is closed.
0103              	NETRX: equ &B400
0103              	NETLINE: equ &B500
0103              	NETTX: equ &B600
0103              	NETPARAM: equ &B700
                 	
                 	; Keep expanded 80-column UI buffers disjoint.
0103              	    assert GRID+TEXT_ROWS*GRID_STRIDE <= EDITOR
0103              	    assert EDITOR+EDITOR_MAX+1 <= ROWBUF
0103              	    assert ROWBUF+256 <= NAMES
0103              	    assert NAMES+768 <= DIRTY
0103              	    assert DIRTY+TEXT_ROWS <= ROWCOLORS
0103              	    assert ROWCOLORS+TEXT_ROWS <= OVERLAY_BACKUP
0103              	    assert OVERLAY_BACKUP+OVERLAY_ROWS*GRID_STRIDE <= OVERLAY_COLORS
0103              	    assert OVERLAY_COLORS+OVERLAY_ROWS <= INPUT_OLD
0103              	    assert INPUT_OLD+INPUT_ROWS*GRID_STRIDE <= VRAM_BACKUP
                 	
                 	; Render cache for status + three editor rows; former unused NAMES area.
0103              	RENDER_CACHE: equ &5500
0103              	CURSOR_CACHE: equ &5640
0103              	CACHE_COLORS: equ &5780
0103              	PAIR_TABLE: equ &57F0
0103              	PIXEL_LUT0: equ &6100
0103              	PIXEL_LUT1: equ &6200
0103              	PIXEL_LUT2: equ &6300
0103              	    assert RENDER_CACHE+4*80 <= CURSOR_CACHE
0103              	    assert CURSOR_CACHE+4*80 <= CACHE_COLORS
0103              	    assert CACHE_COLORS+4 <= PAIR_TABLE
0103              	    assert PAIR_TABLE+4 <= DIRTY
0103              	    assert INPUT_OLD+INPUT_ROWS*GRID_STRIDE <= PIXEL_LUT0
0103              	    assert PIXEL_LUT2+256 <= VRAM_BACKUP
                 	
0103              	CHANGED_CELLS: equ &6040
0103              	    assert INPUT_OLD+INPUT_ROWS*GRID_STRIDE <= CHANGED_CELLS
0103              	    assert CHANGED_CELLS+80 <= PIXEL_LUT0
0103              	    include "CONFIG.ASM"
                 	main:
0103 ED 73 40 02  	    ld (initial_sp),sp
0107 2A 06 00     	    ld hl,(BDOS+1)
010A 11 00 C1     	    ld de,RAM_END+256
010D B7           	    or a
010E ED 52        	    sbc hl,de
0110 DA C7 15     	    jp c,error_ram
0113 21 00 00     	    ld hl,0
0116 39           	    add hl,sp
0117 7C           	    ld a,h
0118 FE C1        	    cp &C1
011A DA CD 15     	    jp c,error_stack
                 	    ; Read BIOS generation via RDSLT; page 0 is DOS RAM here.
011D 3A C1 FC     	    ld a,(EXPTBL)
0120 21 2D 00     	    ld hl,&002D
0123 CD 0C 00     	    call &000C
0126 FB           	    ei
0127 B7           	    or a
0128 CA BB 15     	    jp z,error_msx2
                 	    ; MODE bits 2:1: 00=16KB, 01=64KB, 10=128KB.
                 	    ; Ignore other MODE flags; also retain acceptance of encoding 11.
                 	    ; MSX2 Technical Handbook chapter 2, table 2.22 (appendix 4 has a typo).
012B 3A FC FA     	    ld a,(&FAFC)
012E E6 06        	    and 6
0130 FE 04        	    cp 4
0132 DA C1 15     	    jp c,error_vram128
0135 3A AF FC     	    ld a,(SCRMOD)
0138 FE 04        	    cp 4
013A D2 D3 15     	    jp nc,error_mode
                 	    ; R#1 bit 7 is reserved on V9938/V9958, not a VRAM-size flag.
                 	    ; MSX generation and MODE above determine SCREEN 7 eligibility.
                 	    ; All mutable data live in owned TPA or documented BIOS video state.
013D 21 00 44     	    ld hl,GRID
0140 01 80 07     	    ld bc,TEXT_ROWS*GRID_STRIDE
0143 3E 20        	    ld a,32
0145 CD B1 03     	    call fill_memory
0148 21 00 4C     	    ld hl,EDITOR
014B 01 00 08     	    ld bc,2048
014E AF           	    xor a
014F CD B1 03     	    call fill_memory
0152 21 20 58     	    ld hl,ROWCOLORS
0155 01 18 00     	    ld bc,TEXT_ROWS
0158 3E F1        	    ld a,&F1
015A CD B1 03     	    call fill_memory
015D 3E F4        	    ld a,&F4
015F 32 20 58     	    ld (ROWCOLORS),a
0162 3E B1        	    ld a,&B1
0164 32 37 58     	    ld (ROWCOLORS+FOOTER_ROW),a
0167 CD 34 2F     	    call net_configure
016A CD 78 1F     	    call storage_boot
016D CD 0F 0A     	    call ui_initial
0170 CD 88 1F     	    call storage_show_boot
0173 CD 47 2F     	    call net_show_config
0176 CD 5D 13     	    call editor_update
0179 CD A6 03     	    call mark_all
017C CD 4B 02     	    call screen_enter
017F 2A 9E FC     	    ld hl,(JIFFY)
0182 22 B6 15     	    ld (blink_tick),hl
                 	main_loop:
0185 CD 80 15     	    call keyboard_poll
0188 B7           	    or a
0189 CA 95 01     	    jp z,main_idle
018C CD AE 01     	    call handle_key
018F CD E5 03     	    call render_dirty
0192 C3 85 01     	    jp main_loop
                 	main_idle:
0195 CD 94 15     	    call cursor_tick
0198 CD 04 21     	    call storage_auto_poll
019B CD E5 03     	    call render_dirty
019E C3 85 01     	    jp main_loop
                 	exit_normal:
01A1 CD 13 03     	    call screen_leave
01A4 CD 75 36     	    call net_exit_cleanup
01A7 ED 7B 40 02  	    ld sp,(initial_sp)
01AB C3 00 00     	    jp 0
                 	
                 	handle_key:
01AE 47           	    ld b,a
01AF 3A 60 2C     	    ld a,(history_active)
01B2 B7           	    or a
01B3 78           	    ld a,b
01B4 C2 DB 28     	    jp nz,history_key
01B7 FE 18        	    cp 24
01B9 CA CD 2D     	    jp z,command_cancel
01BC 47           	    ld b,a
01BD AF           	    xor a
01BE 32 87 2E     	    ld (cancel_armed),a
01C1 78           	    ld a,b
01C2 FE 1B        	    cp 27
01C4 CA A1 01     	    jp z,exit_normal
01C7 FE 19        	    cp 25
01C9 CA 98 28     	    jp z,history_open
01CC FE 17        	    cp 23
01CE CA 6C 32     	    jp z,command_network
01D1 FE 13        	    cp 19
01D3 CA 06 20     	    jp z,command_save
01D6 FE 11        	    cp 17
01D8 CA 33 20     	    jp z,command_submit
01DB FE 0F        	    cp 15
01DD CA FD 20     	    jp z,command_response
01E0 FE 04        	    cp 4
01E2 CA 18 20     	    jp z,command_load
01E5 FE 02        	    cp 2
01E7 CA E2 21     	    jp z,command_review
01EA FE 14        	    cp 20
01EC CA 30 22     	    jp z,command_auto
01EF FE 07        	    cp 7
01F1 CA 49 0B     	    jp z,help_toggle
01F4 FE 12        	    cp 18
01F6 CA 4E 0B     	    jp z,calibration_toggle
01F9 FE 10        	    cp 16
01FB CA 03 0B     	    jp z,preview_local
01FE FE 0C        	    cp 12
0200 CA 46 11     	    jp z,editor_clear
0203 FE 08        	    cp 8
0205 CA 0E 11     	    jp z,editor_backspace
0208 FE 7F        	    cp 127
020A CA 1B 11     	    jp z,editor_delete
020D FE 1C        	    cp 28
020F CA 69 11     	    jp z,editor_right
0212 FE 1D        	    cp 29
0214 CA 5C 11     	    jp z,editor_left
0217 FE 1E        	    cp 30
0219 CA C2 11     	    jp z,editor_up
021C FE 1F        	    cp 31
021E CA CF 11     	    jp z,editor_down
0221 FE 0B        	    cp 11
0223 CA 7C 11     	    jp z,editor_home
0226 FE 01        	    cp 1
0228 CA 7C 11     	    jp z,editor_home
022B FE 05        	    cp 5
022D CA A1 11     	    jp z,editor_end
0230 FE 0D        	    cp 13
0232 CA 3B 02     	    jp z,editor_enter
0235 FE 20        	    cp 32
0237 D8           	    ret c
0238 C3 B7 0F     	    jp editor_insert
                 	editor_enter:
023B 3E 0A        	    ld a,10
023D C3 B7 0F     	    jp editor_insert
                 	
0240 00 00        	initial_sp: dw 0
                 	
                 	; SCREEN7.ASM -- V9938 bitmap, page 0, 512x212, 80x24 cells, 6x8 pixels each, 16-pixel margins.
                 	; Uses MAIN-ROM WRTVDP/LDIRMV/LDIRVM only; no SUB-ROM trampoline.
                 	bios_call:
0242 FD 2A C0 FC  	    ld iy,(EXPTBL-1)
0246 CD 1C 00     	    call CALSLT
0249 FB           	    ei
024A C9           	    ret
                 	screen_enter:
024B 21 DF F3     	    ld hl,RG0SAV
024E 11 7B 06     	    ld de,saved_regs
0251 01 08 00     	    ld bc,8
0254 ED B0        	    ldir
0256 21 E7 FF     	    ld hl,&FFE7
0259 01 10 00     	    ld bc,16
025C ED B0        	    ldir
025E 3A AF FC     	    ld a,(SCRMOD)
0261 32 93 06     	    ld (saved_mode),a
0264 3A DE F3     	    ld a,(CNSDFG)
0267 32 94 06     	    ld (saved_cnsdfg),a
026A 3E 01        	    ld a,1
026C 32 DE F3     	    ld (CNSDFG),a
026F 3A F6 FA     	    ld a,(&FAF6)
0272 32 95 06     	    ld (saved_acpage),a
0275 AF           	    xor a
0276 32 F6 FA     	    ld (&FAF6),a
0279 CD AD 06     	    call vdp_init_ports
027C 06 20        	    ld b,&20
027E 0E 01        	    ld c,1
0280 CD 0C 03     	    call screen_reg
                 	    ; In SCREEN 5, addresses are linear. Stash all physical DOS 16K at
                 	    ; 1C000h..1FFFFh using HMMM; this area is outside SCREEN 7 + font atlas.
0283 3E 05        	    ld a,5
0285 32 AF FC     	    ld (SCRMOD),a
0288 06 06        	    ld b,6
028A 0E 00        	    ld c,0
028C CD 0C 03     	    call screen_reg
028F 06 0A        	    ld b,&0A
0291 0E 08        	    ld c,8
0293 CD 0C 03     	    call screen_reg
0296 21 CA 07     	    ld hl,save_dos_command
0299 CD F9 06     	    call vdp_command
029C CD CF 06     	    call vdp_wait
029F 3E 01        	    ld a,1
02A1 32 96 06     	    ld (video_saved),a
02A4 3E 07        	    ld a,7
02A6 32 AF FC     	    ld (SCRMOD),a
                 	    ; Select Graphic 6, display page 0; preserve palette and PAL/NTSC.
02A9 06 0A        	    ld b,&0A
02AB 0E 00        	    ld c,0
02AD CD 0C 03     	    call screen_reg
02B0 06 1F        	    ld b,&1F
02B2 0E 02        	    ld c,2
02B4 CD 0C 03     	    call screen_reg
02B7 06 01        	    ld b,1
02B9 0E 07        	    ld c,7
02BB CD 0C 03     	    call screen_reg
02BE 06 0A        	    ld b,&0A
02C0 0E 08        	    ld c,8
02C2 CD 0C 03     	    call screen_reg
02C5 3A 84 06     	    ld a,(saved_regs+9)
02C8 E6 02        	    and &02
02CA F6 80        	    or &80
02CC 47           	    ld b,a
02CD 0E 09        	    ld c,9
02CF CD 0C 03     	    call screen_reg
02D2 06 00        	    ld b,0
02D4 0E 0E        	    ld c,14
02D6 CD 0C 03     	    call screen_reg
02D9 06 00        	    ld b,0
02DB 0E 17        	    ld c,23
02DD CD 0C 03     	    call screen_reg
02E0 CD 16 07     	    call build_font_atlas
                 	    ; Clear bottom 20 scanlines. ROWBUF remains a single scanline.
02E3 21 00 54     	    ld hl,ROWBUF
02E6 01 00 01     	    ld bc,256
02E9 3E 11        	    ld a,&11
02EB CD B1 03     	    call fill_memory
02EE 3E C0        	    ld a,192
02F0 32 9B 06     	    ld (render_y),a
                 	screen_bottom:
