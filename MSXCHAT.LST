01DB FE 0F        	    cp 15
01DD CA B6 19     	    jp z,command_response
01E0 FE 04        	    cp 4
01E2 CA D1 18     	    jp z,command_load
01E5 FE 02        	    cp 2
01E7 CA 9B 1A     	    jp z,command_review
01EA FE 14        	    cp 20
01EC CA E9 1A     	    jp z,command_auto
01EF FE 07        	    cp 7
01F1 CA 76 06     	    jp z,help_toggle
01F4 FE 12        	    cp 18
01F6 CA 7B 06     	    jp z,calibration_toggle
01F9 FE 10        	    cp 16
01FB CA 30 06     	    jp z,preview_local
01FE FE 0C        	    cp 12
0200 CA 6C 0B     	    jp z,editor_clear
0203 FE 08        	    cp 8
0205 CA 34 0B     	    jp z,editor_backspace
0208 FE 7F        	    cp 127
020A CA 41 0B     	    jp z,editor_delete
020D FE 1C        	    cp 28
020F CA 8F 0B     	    jp z,editor_right
0212 FE 1D        	    cp 29
0214 CA 82 0B     	    jp z,editor_left
0217 FE 1E        	    cp 30
0219 CA E8 0B     	    jp z,editor_up
021C FE 1F        	    cp 31
021E CA F8 0B     	    jp z,editor_down
0221 FE 0B        	    cp 11
0223 CA A2 0B     	    jp z,editor_home
0226 FE 01        	    cp 1
0228 CA A2 0B     	    jp z,editor_home
022B FE 05        	    cp 5
022D CA C7 0B     	    jp z,editor_end
0230 FE 0D        	    cp 13
0232 CA 3B 02     	    jp z,editor_enter
0235 FE 20        	    cp 32
0237 D8           	    ret c
0238 C3 E4 0A     	    jp editor_insert
                 	editor_enter:
023B 3E 0A        	    ld a,10
023D C3 E4 0A     	    jp editor_insert
                 	
0240 00 00        	initial_sp: dw 0
                 	
                 	; SCREEN7.ASM -- V9938 bitmap, page 0, 512x212, 80x24 cells, 6x8 pixels each, 16-pixel margins.
                 	; Uses MAIN-ROM WRTVDP/LDIRMV/LDIRVM only; no SUB-ROM trampoline.
                 	bios_call:
0242 FD 2A C0 FC  	    ld iy,(EXPTBL-1)
0246 CD 1C 00     	    call CALSLT
0249 FB           	    ei
024A C9           	    ret
                 	screen_enter:
