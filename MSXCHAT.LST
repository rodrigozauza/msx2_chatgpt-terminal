                 	    ; Restore physical DOS data in the SAME linear mapping used to save it.
031F 3E 05        	    ld a,5
0321 32 AF FC     	    ld (SCRMOD),a
0324 06 06        	    ld b,6
0326 0E 00        	    ld c,0
0328 CD 0C 03     	    call screen_reg
032B 21 D9 07     	    ld hl,restore_dos_command
032E CD F9 06     	    call vdp_command
0331 CD CF 06     	    call vdp_wait
0334 CD 3A 03     	    call screen_restore_regs
0337 C3 5F 03     	    jp screen_restore_state
                 	screen_restore_regs:
033A AF           	    xor a
033B 32 97 06     	    ld (register_index),a
                 	screen_restore_reg:
033E 3A 97 06     	    ld a,(register_index)
0341 FE 01        	    cp 1
0343 CA 52 03     	    jp z,screen_restore_next
0346 5F           	    ld e,a
0347 16 00        	    ld d,0
0349 21 7B 06     	    ld hl,saved_regs
034C 19           	    add hl,de
034D 46           	    ld b,(hl)
034E 4F           	    ld c,a
