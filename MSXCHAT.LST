036B 3A 95 06     	    ld a,(saved_acpage)
036E 32 F6 FA     	    ld (&FAF6),a
0371 3A 7C 06     	    ld a,(saved_regs+1)
0374 47           	    ld b,a
0375 0E 01        	    ld c,1
0377 CD 0C 03     	    call screen_reg
037A AF           	    xor a
037B 32 96 06     	    ld (video_saved),a
037E C9           	    ret
                 	; A=row. Pattern+color invalidation. Preserves main registers.
                 	mark_row:
037F F5           	    push af
0380 E5           	    push hl
